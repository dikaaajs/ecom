generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TagColor {
  SLATE
  GRAY
  ZINC
  NEUTRAL
  STONE

  RED
  ORANGE
  AMBER
  YELLOW
  LIME
  GREEN
  EMERALD
  TEAL
  CYAN
  SKY
  BLUE
  INDIGO
  VIOLET
  PURPLE
  FUCHSIA
  PINK
  ROSE
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

model Product {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?

  price       Decimal  @db.Decimal(10,2)
  stock       Int      @default(0)

  type        ProductType @default(PHYSICAL)
  weight      Int      @default(0) // gram; no shipping for DIGITAL
  length      Int?     // cm
  width       Int?     // cm
  height      Int?     // cm

  imageUrl    String?

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  tags        Tag[]
  images      ProductImage[]
  orderItems  OrderItem[]
  digitalAsset DigitalAsset?

  isPublished Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique

  products  Product[]

  createdAt DateTime @default(now())

  @@map("categories")
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  color     TagColor  @default(GRAY)

  products  Product[]

  createdAt DateTime @default(now())

  @@map("tags")
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())

  @@map("admin_users")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  addresses CustomerAddress[]
  orders    Order[]
  account   CustomerAccount?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("customers")
}

model CustomerAddress {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String?
  recipient   String
  phone       String
  addressLine String
  province    String
  city        String
  district    String?
  postalCode  String
  isDefault   Boolean @default(false)
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@map("customer_addresses")
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id])
  status       OrderStatus @default(DRAFT)
  currency     String      @default("IDR")
  subtotal     Decimal     @db.Decimal(12,2)
  shippingCost Decimal?    @db.Decimal(12,2)
  total        Decimal?    @db.Decimal(12,2)
  notes        String?
  checkoutAccessHash String? @unique
  destinationDistrictId Int?
  payment      PaymentTransaction?
  recipient    String?
  phone        String?
  addressLine  String?
  province     String?
  city         String?
  district     String?
  postalCode   String?
  items        OrderItem[]
  shipment     Shipment?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id           String      @id @default(cuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTitle String
  productType  ProductType
  quantity     Int
  unitPrice    Decimal     @db.Decimal(12,2)
  lineTotal    Decimal     @db.Decimal(12,2)
  createdAt    DateTime    @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

enum ShipmentStatus {
  PENDING
  READY
  SHIPPED
  DELIVERED
  RETURNED
}

model Shipment {
  id              String         @id @default(cuid())
  orderId         String         @unique
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          ShipmentStatus @default(PENDING)
  courier         String?
  service         String?
  trackingNumber  String?
  totalWeightGram Int
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@map("shipments")
}

model DigitalAsset {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  bucket      String
  objectPath  String
  fileName    String
  contentType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("digital_assets")
}

// Midtrans payment record. Guest order access uses an unguessable token whose
// SHA-256 hash is stored on Order, never the raw token.
enum PaymentState {
  INITIALIZING
  PENDING
  PAID
  CANCELLED
}

model PaymentTransaction {
  id                String       @id @default(cuid())
  orderId           String       @unique
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String       @default("MIDTRANS")
  providerOrderId   String       @unique
  state             PaymentState @default(INITIALIZING)
  amount            Decimal      @db.Decimal(12,2)
  redirectUrl       String?
  paidAt            DateTime?
  lastNotificationAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([state, createdAt])
  @@map("payment_transactions")
}

/** Customer credentials separate from merchant/admin accounts. */
model CustomerAccount {
  id           String   @id @default(cuid())
  customerId   String   @unique
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  emailVerifiedAt DateTime?
  sessionVersion Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("customer_accounts")
}

enum AccountTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model AccountActionToken {
  id String @id @default(cuid())
  accountId String
  purpose AccountTokenPurpose
  tokenHash String @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([accountId, purpose, createdAt])
  @@index([expiresAt])
  @@map("account_action_tokens")
}

model AuthRateLimit {
  key String @id
  count Int @default(0)
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("auth_rate_limits")
}
